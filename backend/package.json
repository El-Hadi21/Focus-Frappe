{
  "name": "focus-frappe-backend",
  "version": "1.0.0",
  "description": "API Node.js pour le projet d'ergothérapie",
  "main": "server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint -c .eslintrc.js src/",
    "lint:fix": "eslint -c .eslintrc.js src/ --fix",
    "start:e2e": "rimraf ./database/e2e && mkdirp ./database/e2e && copyfiles -u 2 \"./database/e2e-starter/**/*\" ./database/e2e && cross-env DB_FOLDER=e2e/ node src/server.js"
  },
  "precommit": [
    "lint"
  ],
  "dependencies": {
    "body-parser": "1.19.0",
    "cors": "2.8.5",
    "express": "^4.17.1",
    "joi": "14.3.1",
    "morgan": "1.9.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "6.8.0",
    "eslint-config-airbnb-base": "14.0.0",
    "eslint-plugin-import": "2.20.0",
    "mkdirp": "^3.0.1",
    "nodemon": "2.0.2",
    "pre-commit": "1.2.2",
    "rimraf": "^5.0.1"
  },
  "nodemonConfig": {
    "ignore": [
      "database/*"
    ]
  }
}